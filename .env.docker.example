# Copy this file to .env.docker and fill in the values before running docker compose.
# Never commit .env.docker to source control.

# ── Required ─────────────────────────────────────────────────
# Shared JWT secret for the Java backend (≥32 chars, strong random)
JWT_SECRET=replace-me-with-a-strong-random-secret-at-least-32-chars

# Admin UI password
ADMIN_PASSWORD=replace-me-with-a-strong-password

# ── Optional ──────────────────────────────────────────────────
# Ollama models directory on the host (leave blank to use Docker named volume)
#OLLAMA_MODELS_DIR=/home/user/.ollama/models

# GPU layers for Ollama inference (-1 = auto)
# For a 6 GB VRAM GPU running a 16 GB model, set to e.g. 18
#OLLAMA_NUM_GPU=-1

# CORS origins for the Java backend (comma-separated, * allows all)
#CORS_ALLOWED_ORIGINS=*

# Auto memory distillation interval (turns between fact-extraction runs)
#MEMORY_DISTILL_INTERVAL=5

# Session summary interval (turns between summary generation)
#MEMORY_SUMMARY_INTERVAL=10

# Ollama 推理参数（--profile local）
#OLLAMA_MODEL=qwen2.5:7b
#OLLAMA_TIMEOUT=600s
#OLLAMA_KEEP_ALIVE=10m
#OLLAMA_NUM_CTX=4096

# 记忆蒸馏 / 嵌入（Ollama nomic-embed-text）
#LLM_EXTRACTION_ENABLED=true
#EMBEDDING_ENABLED=true
#EMBEDDING_MODEL=nomic-embed-text

# 数据库只读工具（DatabaseTool；未配置时注册但不可用）
#DB_TYPE=mysql
#DB_HOST=
#DB_PORT=3306
#DB_DATABASE=
#DB_USER=
#DB_PASSWORD=

# 图片生成（Java 后端 ComfyUI-only）
#IMAGE_GEN_PROVIDER=comfyui
# ComfyUI 容器（--profile local）：
#IMAGE_GEN_BASE_URL=http://comfyui:8188
# ComfyUI 跑在宿主机：
#IMAGE_GEN_BASE_URL=http://host.docker.internal:8188
#IMAGE_GEN_MODEL=

# ── 飞书 IM 接入（可选，详见 docs/feishu-integration.md）────────
# 在 https://open.feishu.cn 创建自建应用后填写
#FEISHU_ENABLED=true
#FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
#FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#FEISHU_ENCRYPT_KEY=
#FEISHU_VERIFICATION_TOKEN=
# 机器人自身的 open_id（飞书开放平台「凭证与基础信息」页可查看），
# 用于群聊场景精确判断"是否 @ 了机器人"；留空时退化为低精度启发式
#FEISHU_BOT_OPEN_ID=
# 飞书 OAuth（个人日历/任务授权）与送达验证接收人：
#FEISHU_OAUTH_REDIRECT_URI=https://<your-domain>/api/feishu/oauth/callback
#FEISHU_OAUTH_ENCRYPTION_KEY=
#FEISHU_HEARTBEAT_RECEIVER_ID=ou_xxxxxxxxxxxxxxxx

# ── 企业微信 IM 接入（可选）──────────────────────────────
# 在 https://work.weixin.qq.com 创建自建应用后填写（应用 → 应用管理 → 自建）
#WECOM_ENABLED=true
#WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
#WECOM_AGENT_ID=1000002
#WECOM_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 回调配置（应用 → 接收消息 → 设置 API 接收）
#WECOM_TOKEN=
#WECOM_AES_KEY=
# 真实送达验证接收人（成员账号 userid，管理后台「通讯录 → 成员管理」查看）
#WECOM_HEARTBEAT_RECEIVER_ID=

# ── Telegram IM 接入（可选）──────────────────────────────
# 在 https://t.me/BotFather 创建 Bot 后获取 Token
#TELEGRAM_ENABLED=true
#TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# 真实送达验证接收 chat_id（私聊：向 Bot 发一条消息后在
# https://api.telegram.org/bot<TOKEN>/getUpdates 里查 chat.id）
#TELEGRAM_HEARTBEAT_RECEIVER_ID=

# ── ngrok 公网隧道（可选，与 cloudflared 二选一）──────────
#NGROK_AUTHTOKEN=
#NGROK_DOMAIN=your-domain.ngrok-free.dev

# ── Cloudflare Tunnel（外网访问，可选）────────────────────────
# 在 Cloudflare Zero Trust 控制台创建 Tunnel 后获取 Token
# 启动命令：docker compose --profile tunnel up -d cloudflared
#CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
