# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30

# 模型参数
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=512
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_NUM_CTX=2048

# API 服务器
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# 记忆配置（路径由 settings.py 自动计算，通常不需要改）
# CHROMA_PERSIST_DIR=./chroma-data
# LONG_TERM_PERSIST_DIR=./chroma-data-longterm

# 网页搜索
# SERPAPI_KEY=
# TAVILY_API_KEY=

# JWT 鉴权（必须与 Java 后端使用的 JWT_SECRET 保持一致）
JWT_SECRET=your-strong-random-secret-here-minimum-32-characters
JWT_ENABLED=true